<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Security-Header (CSP, HSTS, X-Frame-Options, ...) werden bewusst NICHT hier
# gesetzt, sondern in Plesk unter "Apache-Einstellungen -> Zusätzliche Header"
# (Domain vzugshop.ch/www.vzugshop.ch, Format "Name: Wert" pro Zeile). Das war
# nötig, weil Plesks "Intelligente Bearbeitung statischer Dateien" GET-Aufrufe
# auf statische Dateien früher am Apache-Backend vorbeigeleitet hat, wodurch
# .htaccess-Header ignoriert wurden (siehe docs/live-audit-summary.md). Diese
# Option ist inzwischen deaktiviert, Apache verarbeitet nun alle Anfragen -
# Header trotzdem nicht hier duplizieren, Plesk bleibt die einzige Quelle.

---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	ogImage?: string;
}

const {
	title,
	description = 'Elektro Breitenmoser AG – Ihr V‑ZUG Fachhändler und Servicepartner in Marbach, Ostschweiz. Lieferung in die ganze Deutschschweiz.',
	noindex = false,
	ogImage = '/og-default.jpg',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const fullTitle = `${title} · Elektro Breitenmoser AG`;

const localBusinessJsonLd = {
	'@context': 'https://schema.org',
	// ElectronicsStore ist der treffendste schema.org-Subtyp von LocalBusiness für
	// ein Verkaufsgeschäft für Haushaltgeräte (kein eigener "ApplianceStore"-Typ
	// vorhanden) - erbt alle LocalBusiness-Eigenschaften, kein Rich-Result-Verlust.
	'@type': 'ElectronicsStore',
	name: 'Elektro Breitenmoser AG',
	// Reales Standort-/Gebäudefoto statt Logo, wie von Google für LocalBusiness
	// empfohlen (og-default.jpg basiert auf dem Hero-Gebäudefoto in Marbach).
	image: [new URL('/og-default.jpg', Astro.site).toString()],
	logo: new URL('/logo.png', Astro.site).toString(),
	url: Astro.site?.toString(),
	telephone: '+41717771276',
	email: 'info@vzugshop.ch',
	taxID: 'CHE-108.098.718',
	// Gründungsjahr 1933, verifiziert über Zeitungsartikel zur Firmengeschichte
	// (siehe docs/research.md), identisch zur Timeline auf /ueber-uns/.
	foundingDate: '1933',
	// Grobe Preiskategorie: V‑ZUG ist Premium-Segment, alle Produkte/Formular-
	// Preiskategorien auf der Website liegen im oberen Preissegment.
	priceRange: '$$$',
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Fortunastrasse 2',
		postalCode: '9437',
		addressLocality: 'Marbach',
		addressRegion: 'SG',
		addressCountry: 'CH',
	},
	// Koordinaten für Fortunastrasse 2, 9437 Marbach, verifiziert per
	// Geocoding (Gebäude-genauer Treffer, nicht nur Ortszentrum).
	geo: {
		'@type': 'GeoCoordinates',
		latitude: 47.394351,
		longitude: 9.573367,
	},
	hasMap: 'https://www.google.com/maps/search/?api=1&query=Fortunastrasse+2%2C+CH-9437+Marbach',
	// Länderweite Angabe deckt die reale Lieferung in die ganze Deutschschweiz ab;
	// die vier Ostschweizer Kantone werden zusätzlich als eigene State-Einträge
	// genannt, weil das Kerneinzugsgebiet (Rheintal, St. Gallen, Appenzellerland,
	// Thurgau) dort liegt - keine Erweiterung des Liefergebiets, nur präzisere
	// regionale Zuordnung für Suchmaschinen.
	areaServed: [
		{
			'@type': 'Country',
			name: 'Schweiz',
		},
		{ '@type': 'State', name: 'Kanton St. Gallen' },
		{ '@type': 'State', name: 'Kanton Thurgau' },
		{ '@type': 'State', name: 'Kanton Appenzell Ausserrhoden' },
		{ '@type': 'State', name: 'Kanton Appenzell Innerrhoden' },
	],
	// Kein openingHoursSpecification: Besuche sind nur nach Vereinbarung möglich,
	// es gibt keine festen Öffnungstage/-zeiten zu deklarieren (siehe docs/research.md).
	sameAs: ['https://www.instagram.com/breitenmoserag_vzug/'],
};
---

<html lang="de-CH">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalUrl} />
		<title>{fullTitle}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Elektro Breitenmoser AG" />
		<meta property="og:locale" content="de_CH" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		{/* set:html hier nur mit statischen, entwicklerkontrollierten Werten befüllen - kein Nutzer-/CMS-Input ohne Sanitizing */}
		<script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
	</head>
	<body class="flex min-h-screen flex-col bg-white text-slate-800">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
		<WhatsAppButton />
	</body>
</html>

---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import kueche1 from '../assets/images/inspiration-kueche-1.jpg';
import kueche2 from '../assets/images/inspiration-kueche-2.jpg';
import waschturm from '../assets/images/inspiration-waschturm.jpg';
import weinkuehler from '../assets/images/inspiration-weinkuehler.jpg';
import installation from '../assets/images/inspiration-installation.jpg';

const gallery = [
	{ src: kueche1, alt: 'V-ZUG Kücheninsel mit Kühlschrank und Backöfen' },
	{ src: kueche2, alt: 'V-ZUG Einbaugeräte in offener Küche' },
	{ src: waschturm, alt: 'V-ZUG Waschtürme im Showroom' },
	{ src: weinkuehler, alt: 'V-ZUG Weinkühlschrank, eingebaut' },
	{ src: installation, alt: 'Von der Elektro Breitenmoser AG installierter Waschturm' },
];
---

<Layout title="Inspiration" description="Inspiration rund um V-ZUG Küchen- und Waschereigeräte.">
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<h1 class="text-3xl font-bold text-slate-900">Inspiration</h1>
		<p class="mt-3 max-w-2xl text-slate-600">
			Eindrücke von V-ZUG Geräten und einer unserer Installationen – für Ihre
			eigene Küchen- oder Waschraumplanung.
		</p>
		<div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
			{
				gallery.map((item) => (
					<Image
						src={item.src}
						alt={item.alt}
						class="aspect-square w-full rounded-lg object-cover"
						widths={[300, 500, 800]}
						sizes="(min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw"
					/>
				))
			}
		</div>
	</section>
</Layout>

---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroStandort from '../assets/images/hero-standort.jpg';
import nachhaltigkeitErsatzteile from '../assets/images/nachhaltigkeit-ersatzteile.jpg';

const h2 =
	'text-[24px] leading-[1.3] font-semibold text-slate-900 sm:text-[28px] md:text-[30px] lg:text-[34px]';
const kickerBrand = 'text-[13px] font-semibold uppercase tracking-[0.08em] text-brand-dark';
const kickerVzug = 'text-[13px] font-semibold uppercase tracking-[0.08em] text-vzug';

const gebaeudeFakten = [
	{ label: 'PEB-Wert (Eigenenergieversorgung)', value: '227 %' },
	{ label: 'Verbautes Holz', value: '125 m³' },
	{ label: 'Dadurch gebundenes CO2', value: '99 Tonnen' },
	{ label: 'Wärmeerzeugung', value: 'Erdsonden-Wärmepumpe' },
	{ label: 'Auszeichnung', value: 'PEB®-Solarpreis-Diplom 2013' },
];
---

<Layout
	title="Nachhaltigkeit"
	description="Nachhaltigkeit bei der Elektro Breitenmoser AG: unser PlusEnergieBau in Marbach und die Nachhaltigkeitsstrategie unseres Partners V‑ZUG."
>
	<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
		<p class={kickerBrand}>Nachhaltigkeit</p>
		<h1 class="mt-3 text-[32px] font-bold leading-[1.15] text-slate-900 sm:text-[40px] sm:leading-[1.1] lg:text-[56px]">
			Verantwortung, die man messen kann
		</h1>
		<p class="mx-auto mt-4 max-w-2xl text-slate-600">
			Nachhaltigkeit ist für uns kein Schlagwort, sondern gebaute und gelebte
			Praxis – bei unserem eigenen Geschäftshaus ebenso wie bei unserem Partner
			V‑ZUG.
		</p>
	</section>

	<section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
		<div class="grid items-center gap-10 rounded-xl border border-slate-200 bg-brand-50 p-6 sm:p-8 md:grid-cols-2">
			<div>
				<p class={kickerBrand}>Unser Gebäude</p>
				<h2 class:list={['mt-2', h2]}>Ein PlusEnergieBau in Marbach</h2>
				<p class="mt-3 text-slate-600">
					Unser 2013 bezogenes Geschäftshaus an der Fortunastrasse in Marbach
					wurde als PlusEnergieBau (PEB) konzipiert: Es erzeugt deutlich mehr
					Energie, als für den laufenden Betrieb benötigt wird. Möglich machen
					das eine grossflächige Photovoltaikanlage auf Dach und Südfassade
					sowie eine Erdsonden-Wärmepumpe für die Wärmeerzeugung. Das
					Untergeschoss steht in Massivbauweise, die Obergeschosse wurden in
					Holzelementbauweise erstellt – dadurch sind rund 125 m³ Holz verbaut,
					was der Atmosphäre etwa 99 Tonnen CO2 entzieht. Für dieses Konzept
					wurde das Gebäude mit dem PEB®-Solarpreis-Diplom 2013 ausgezeichnet.
				</p>
				<dl class="mt-6 grid grid-cols-2 gap-x-4 gap-y-4 sm:grid-cols-1">
					{
						gebaeudeFakten.map((fakt) => (
							<div class="flex items-baseline justify-between gap-4 border-b border-brand-100 pb-2 sm:justify-start sm:gap-6">
								<dt class="text-sm text-slate-600">{fakt.label}</dt>
								<dd class="text-sm font-semibold text-brand-dark">{fakt.value}</dd>
							</div>
						))
					}
				</dl>
			</div>
			<Image
				src={heroStandort}
				alt="Geschäftshaus der Elektro Breitenmoser AG in Marbach mit Photovoltaikanlage auf dem Dach"
				class="aspect-[4/3] w-full rounded-lg object-cover shadow-sm"
				widths={[400, 800, 1200]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
		<div class="grid items-center gap-10 rounded-xl border border-slate-200 border-t-4 border-t-vzug bg-white p-6 shadow-sm sm:p-8 md:grid-cols-2">
			<Image
				src={nachhaltigkeitErsatzteile}
				alt="Ausgebaute Einzelteile eines V‑ZUG Geräts, sortiert für die Kreislaufwirtschaft"
				class="aspect-[4/3] w-full rounded-lg object-cover shadow-sm md:order-2"
				widths={[400, 800, 1200]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
			<div class="md:order-1">
				<p class={kickerVzug}>Unser Partner V‑ZUG</p>
				<h2 class:list={['mt-2', h2]}>Kreislaufwirtschaft statt Wegwerfprinzip</h2>
				<p class="mt-3 text-slate-600">
					V‑ZUG produziert seit 2020 an beiden Schweizer Standorten Zug und
					Sulgen CO2-neutral und kompensiert die verbleibenden Emissionen unter
					anderem über das Aufforstungsprojekt «V-Forest» in Schottland. Die
					langfristige Nachhaltigkeitsstrategie von V‑ZUG folgt dem Prinzip der
					Kreislaufwirtschaft: Neue Geräte werden nach «Design to
					Circularity»-Prinzipien entwickelt – mit dem Ziel einer möglichst
					sortenreinen Demontage und Wiederverwertung von Komponenten und
					Materialien. So wie auf dem Bild links: einzelne Bauteile eines
					V‑ZUG Geräts, säuberlich getrennt für Reparatur oder Recycling.
					Ausserdem hält V‑ZUG Ersatzteile bis zu 15 Jahre nach dem Verkauf
					eines Geräts bereit, damit sich eine Reparatur lohnt statt eines
					Neukaufs.
				</p>
				<a
					href="https://www.vzug.com/ch/de/sustainability"
					target="_blank"
					rel="noopener noreferrer"
					class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent-dark hover:text-accent"
				>
					Mehr zur Nachhaltigkeit von V‑ZUG
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<section class="py-16">
		<div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
			<h2 class={h2}>Fragen zu einem V‑ZUG Gerät?</h2>
			<p class="mt-3 text-slate-600">
				Wir beraten Sie gerne auch dazu, welches Gerät zu Ihrem Anspruch an
				Effizienz und Langlebigkeit passt.
			</p>
			<a
				href="/geraeteanfrage/"
				class="mt-6 inline-block rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white hover:bg-brand-dark"
			>
				Geräteanfrage stellen
			</a>
		</div>
	</section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { rooms } from '../data/appliances';

const web3formsAccessKey = 'b82697eb-f0f3-4c3f-b9f1-9073e53d8d7a';

const priceCategories = [
	'Auslaufmodelle, Importware, Schnäppchenecke',
	'Swiss Made Basic',
	'Swiss Made Classic',
	'Swiss Made Premium',
	'Swiss Made Premium De Luxe',
];
---

<Layout title="V‑ZUG Geräteanfrage Marbach" description="Unverbindliche Geräteanfrage für V‑ZUG Geräte. Elektro Breitenmoser AG in Marbach berät Sie persönlich – von der Auswahl bis zur Installation.">
	<section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
		<h1 class="text-3xl font-bold text-slate-900">Geräteanfrage</h1>
		<p class="mt-3 text-slate-600">
			Interessieren Sie sich für ein V‑ZUG Gerät? Senden Sie uns Ihre Anfrage –
			wir melden uns persönlich bei Ihnen.
		</p>

		<form action="https://api.web3forms.com/submit" method="POST" class="mt-8 space-y-5">
			<input type="hidden" name="access_key" value={web3formsAccessKey} />
			<input type="hidden" name="subject" value="Neue Geräteanfrage von vzugshop.ch" />
			<input type="hidden" name="from_name" value="Website-Formular Elektro Breitenmoser AG" />
			<input type="hidden" name="redirect" value={new URL('/danke/', Astro.site).toString()} />
			<input
				type="checkbox"
				name="botcheck"
				tabindex="-1"
				autocomplete="off"
				class="hidden"
				aria-hidden="true"
			/>

			<p class="text-xs text-slate-500">Mit * markierte Felder sind Pflichtfelder.</p>
			<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
				<div>
					<label for="firstname" class="block text-sm font-medium text-slate-700"
						>Vorname *</label
					>
					<input
						type="text"
						name="firstname"
						id="firstname"
						required
						class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
					/>
				</div>
				<div>
					<label for="name" class="block text-sm font-medium text-slate-700">Nachname *</label>
					<input
						type="text"
						name="name"
						id="name"
						required
						class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
					/>
				</div>
			</div>
			<div>
				<label for="email" class="block text-sm font-medium text-slate-700">E-Mail *</label>
				<input
					type="email"
					name="email"
					id="email"
					required
					class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
				/>
			</div>
			<div>
				<label for="phone" class="block text-sm font-medium text-slate-700">Telefon *</label>
				<input
					type="tel"
					name="phone"
					id="phone"
					required
					class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
				/>
			</div>
			<div class="grid grid-cols-1 gap-5 sm:grid-cols-[2fr_1fr]">
				<div>
					<label for="strasse" class="block text-sm font-medium text-slate-700">Strasse</label>
					<input
						type="text"
						name="strasse"
						id="strasse"
						class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
					/>
				</div>
				<div>
					<label for="hausnummer" class="block text-sm font-medium text-slate-700"
						>Hausnummer</label
					>
					<input
						type="text"
						name="hausnummer"
						id="hausnummer"
						class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
					/>
				</div>
			</div>
			<div class="grid grid-cols-1 gap-5 sm:grid-cols-[1fr_2fr]">
				<div>
					<label for="plz" class="block text-sm font-medium text-slate-700">PLZ</label>
					<input
						type="text"
						name="plz"
						id="plz"
						inputmode="numeric"
						class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
					/>
				</div>
				<div>
					<label for="ort" class="block text-sm font-medium text-slate-700">Ort</label>
					<input
						type="text"
						name="ort"
						id="ort"
						class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
					/>
				</div>
			</div>
			<div id="device-group">
				<span class="block text-sm font-medium text-slate-700"
					>Gewünschter Gerätebereich * <span class="font-normal text-slate-500"
						>(Mehrfachauswahl möglich)</span
					></span
				>
				<div class="mt-2 space-y-4">
					{
						rooms.map((r) => (
							<div>
								<p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
									{r.room}
								</p>
								<div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
									{r.items.map((item) => (
										<label class="flex items-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-700 hover:border-brand">
											<input
												type="checkbox"
												name="device"
												value={item.label}
												data-slug={item.slug}
												class="h-4 w-4 rounded border-slate-300 text-brand focus:ring-brand"
											/>
											{item.label}
										</label>
									))}
								</div>
							</div>
						))
					}
				</div>
				<p id="device-error" class="mt-2 hidden text-xs text-red-600">
					Bitte wählen Sie mindestens eine Gerätekategorie aus.
				</p>
			</div>
			<div>
				<label for="budget" class="block text-sm font-medium text-slate-700"
					>Preiskategorie *</label
				>
				<select
					name="budget"
					id="budget"
					required
					class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
				>
					<option value="" disabled selected>Bitte wählen …</option>
					{priceCategories.map((category) => <option value={category}>{category}</option>)}
					<option value="Preiskategorie lieber telefonisch besprechen">
						Preiskategorie lieber telefonisch besprechen
					</option>
				</select>
			</div>
			<div>
				<label for="message" class="block text-sm font-medium text-slate-700"
					>Nachricht / Wünsche / Budget / etc. *</label
				>
				<textarea
					name="message"
					id="message"
					rows="5"
					required
					class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
				></textarea>
			</div>
			<button
				type="submit"
				class="rounded-md bg-brand px-6 py-3 text-sm font-semibold text-white hover:bg-brand-dark"
			>
				Anfrage senden
			</button>
		</form>
	</section>

	<section class="mx-auto max-w-2xl px-4 pb-16 sm:px-6">
		<h2 class="text-xl font-semibold text-slate-900">So finden Sie uns</h2>
		<p class="mt-2 text-sm text-slate-600">
			Fortunastrasse 2, CH-9437 Marbach. Bitte vereinbaren Sie einen Termin
			für den Besuch unserer Ausstellung telefonisch mit uns.
		</p>
		<div class="mt-4 overflow-hidden rounded-lg border border-slate-200 shadow-sm">
			<iframe
				title="Standort Elektro Breitenmoser AG, Fortunastrasse 2, Marbach"
				src="https://www.google.com/maps?q=Fortunastrasse+2,+9437+Marbach&output=embed"
				width="100%"
				height="350"
				style="border:0"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
			></iframe>
		</div>
		<a
			href="https://www.google.com/maps/search/?api=1&query=Fortunastrasse+2%2C+CH-9437+Marbach"
			target="_blank"
			rel="noopener noreferrer"
			class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-dark"
		>
			Route in Google Maps öffnen
			<span aria-hidden="true">→</span>
		</a>
	</section>
</Layout>

<script>
	const deviceCheckboxes = document.querySelectorAll('input[name="device"]');
	const deviceError = document.getElementById('device-error');
	const form = document.querySelector('form');

	const params = new URLSearchParams(window.location.search);
	const slug = params.get('geraet');
	if (slug) {
		deviceCheckboxes.forEach((cb) => {
			if (cb instanceof HTMLInputElement && cb.dataset.slug === slug) {
				cb.checked = true;
			}
		});
	}

	form?.addEventListener('submit', (event) => {
		const anyChecked = Array.from(deviceCheckboxes).some(
			(cb) => cb instanceof HTMLInputElement && cb.checked
		);
		if (!anyChecked) {
			event.preventDefault();
			deviceError?.classList.remove('hidden');
			document.getElementById('device-group')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
		} else {
			deviceError?.classList.add('hidden');
		}
	});
</script>

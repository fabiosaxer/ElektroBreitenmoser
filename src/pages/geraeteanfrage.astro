---
import Layout from '../layouts/Layout.astro';
import { rooms } from '../data/appliances';

const web3formsAccessKey = 'b82697eb-f0f3-4c3f-b9f1-9073e53d8d7a';

const budgetRanges = [
	'Bis CHF 2’000',
	'CHF 2’000 – 5’000',
	'CHF 5’000 – 10’000',
	'CHF 10’000 – 20’000',
	'Über CHF 20’000',
	'Noch offen / möchte ich besprechen',
];
---

<Layout title="V-ZUG Geräteanfrage Marbach" description="Unverbindliche Geräteanfrage für V-ZUG Geräte. Elektro Breitenmoser AG in Marbach berät Sie persönlich – von der Auswahl bis zur Installation im Rheintal.">
	<section class="mx-auto max-w-2xl px-4 py-16 sm:px-6">
		<h1 class="text-3xl font-bold text-slate-900">Geräteanfrage</h1>
		<p class="mt-3 text-slate-600">
			Interessieren Sie sich für ein V-ZUG Gerät? Senden Sie uns Ihre Anfrage –
			wir melden uns persönlich bei Ihnen.
		</p>

		<form action="https://api.web3forms.com/submit" method="POST" class="mt-8 space-y-5">
			<input type="hidden" name="access_key" value={web3formsAccessKey} />
			<input type="hidden" name="subject" value="Neue Geräteanfrage von vzugshop.ch" />
			<input type="hidden" name="from_name" value="Website-Formular Elektro Breitenmoser AG" />
			<input
				type="checkbox"
				name="botcheck"
				tabindex="-1"
				autocomplete="off"
				class="hidden"
				aria-hidden="true"
			/>

			<p class="text-xs text-slate-500">Mit * markierte Felder sind Pflichtfelder.</p>
			<div>
				<label for="name" class="block text-sm font-medium text-slate-700">Name *</label>
				<input
					type="text"
					name="name"
					id="name"
					required
					class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
				/>
			</div>
			<div>
				<label for="email" class="block text-sm font-medium text-slate-700">E-Mail *</label>
				<input
					type="email"
					name="email"
					id="email"
					required
					class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
				/>
			</div>
			<div>
				<label for="phone" class="block text-sm font-medium text-slate-700"
					>Telefon (optional)</label
				>
				<input
					type="tel"
					name="phone"
					id="phone"
					class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
				/>
			</div>
			<div>
				<label for="device" class="block text-sm font-medium text-slate-700"
					>Gewünschter Gerätebereich *</label
				>
				<select
					name="device"
					id="device"
					required
					class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
				>
					<option value="">Bitte wählen …</option>
					{
						rooms.map((r) => (
							<optgroup label={r.room}>
								{r.items.map((item) => (
									<option value={item.label} data-slug={item.slug}>
										{item.label}
									</option>
								))}
							</optgroup>
						))
					}
				</select>
			</div>
			<div>
				<label for="budget" class="block text-sm font-medium text-slate-700"
					>Budgetrahmen (optional)</label
				>
				<select
					name="budget"
					id="budget"
					class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
				>
					<option value="">Keine Angabe</option>
					{budgetRanges.map((range) => <option value={range}>{range}</option>)}
				</select>
			</div>
			<div>
				<label for="message" class="block text-sm font-medium text-slate-700"
					>Nachricht *</label
				>
				<textarea
					name="message"
					id="message"
					rows="5"
					required
					class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand"
				></textarea>
			</div>
			<button
				type="submit"
				class="rounded-md bg-brand px-6 py-3 text-sm font-semibold text-white hover:bg-brand-dark"
			>
				Anfrage senden
			</button>
		</form>
	</section>

	<section class="mx-auto max-w-2xl px-4 pb-16 sm:px-6">
		<h2 class="text-xl font-semibold text-slate-900">So finden Sie uns</h2>
		<p class="mt-2 text-sm text-slate-600">
			Fortunastrasse 2, CH-9437 Marbach · Besuch nach Vereinbarung – bitte
			vorab kurz anrufen.
		</p>
		<div class="mt-4 overflow-hidden rounded-lg border border-slate-200 shadow-sm">
			<iframe
				title="Standort Elektro Breitenmoser AG, Fortunastrasse 2, Marbach"
				src="https://www.google.com/maps?q=Fortunastrasse+2,+9437+Marbach&output=embed"
				width="100%"
				height="350"
				style="border:0"
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
			></iframe>
		</div>
		<a
			href="https://www.google.com/maps/search/?api=1&query=Fortunastrasse+2%2C+CH-9437+Marbach"
			target="_blank"
			rel="noopener noreferrer"
			class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:text-brand-dark"
		>
			Route in Google Maps öffnen
			<span aria-hidden="true">→</span>
		</a>
	</section>
</Layout>

<script>
	const params = new URLSearchParams(window.location.search);
	const slug = params.get('geraet');
	if (slug) {
		const select = document.getElementById('device');
		if (select instanceof HTMLSelectElement) {
			const option = Array.from(select.options).find((o) => o.dataset.slug === slug);
			if (option) {
				select.value = option.value;
			}
		}
	}
</script>

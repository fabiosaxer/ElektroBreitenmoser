---
import Layout from '../layouts/Layout.astro';
import ApplianceIcon from '../components/ApplianceIcon.astro';

// TODO: Formspree-/Web3Forms-Account anlegen und Endpoint hier eintragen.
const formEndpoint = 'https://formspree.io/f/REPLACE_ME';

const rooms = [
	{
		room: 'Küche',
		items: [
			{ slug: 'freistehende-gefriergeraete', label: 'Freistehende Gefriergeräte' },
			{ slug: 'steamer', label: 'Steamer' },
			{ slug: 'backoefen-herde', label: 'Backöfen/Herde' },
			{ slug: 'schubladen', label: 'Schubladen' },
			{ slug: 'mikrowellen', label: 'Mikrowellen' },
			{ slug: 'kaffeevollautomaten', label: 'Einbau-Kaffeevollautomaten' },
			{ slug: 'kochfelder', label: 'Kochfelder' },
			{ slug: 'kochfelder-dunstabzug', label: 'Kochfelder mit Dunstabzug' },
			{ slug: 'dunstabzuege', label: 'Dunstabzüge' },
			{ slug: 'geschirrspueler', label: 'Geschirrspüler' },
			{ slug: 'kuehl-gefrierschraenke', label: 'Einbau-Kühl- und Gefrierschränke' },
		],
	},
	{
		room: 'Waschküche',
		items: [
			{ slug: 'waschmaschinen', label: 'Waschmaschinen' },
			{ slug: 'waeschetrockner', label: 'Wäschetrockner' },
			{ slug: 'waschtuerme', label: 'Waschtürme' },
		],
	},
];
---

<Layout title="Geräteanfrage" description="Fragen Sie Ihr V-ZUG Gerät unverbindlich bei uns an.">
	<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
		<h1 class="text-3xl font-bold text-slate-900">Geräteanfrage</h1>
		<p class="mt-3 max-w-2xl text-slate-600">
			Für welchen Geräte­bereich interessieren Sie sich? Wählen Sie eine Kachel –
			wir übernehmen die Auswahl direkt ins Formular.
		</p>

		{
			rooms.map((r) => (
				<div class="mt-10">
					<h2 class="text-lg font-semibold text-slate-900">{r.room}</h2>
					<div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
						{r.items.map((item) => (
							<button
								type="button"
								data-device={item.label}
								class="device-tile group flex flex-col items-center gap-3 rounded-xl border border-slate-200 bg-white p-5 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-brand hover:shadow-md"
							>
								<ApplianceIcon
									name={item.slug}
									class="h-10 w-10 text-brand transition group-hover:text-accent"
								/>
								<span class="text-sm font-medium text-slate-700">{item.label}</span>
							</button>
						))}
					</div>
				</div>
			))
		}
	</section>

	<section id="anfrage-formular" class="mx-auto max-w-2xl scroll-mt-8 px-4 pb-16 sm:px-6">
		<div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
			<h2 class="text-xl font-semibold text-slate-900">Ihre Anfrage</h2>
			<p class="mt-2 text-sm text-slate-600">
				Senden Sie uns Ihre Anfrage – wir melden uns persönlich bei Ihnen.
			</p>

			<form action={formEndpoint} method="POST" class="mt-6 space-y-5">
				<div>
					<label for="name" class="block text-sm font-medium text-slate-700">Name</label>
					<input
						type="text"
						name="name"
						id="name"
						required
						class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
					/>
				</div>
				<div>
					<label for="email" class="block text-sm font-medium text-slate-700">E-Mail</label>
					<input
						type="email"
						name="email"
						id="email"
						required
						class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
					/>
				</div>
				<div>
					<label for="phone" class="block text-sm font-medium text-slate-700"
						>Telefon (optional)</label
					>
					<input
						type="tel"
						name="phone"
						id="phone"
						class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
					/>
				</div>
				<div>
					<label for="device" class="block text-sm font-medium text-slate-700"
						>Gewünschter Gerätebereich</label
					>
					<select
						name="device"
						id="device"
						required
						class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
					>
						<option value="">Bitte wählen …</option>
						{
							rooms.map((r) => (
								<optgroup label={r.room}>
									{r.items.map((item) => (
										<option value={item.label}>{item.label}</option>
									))}
								</optgroup>
							))
						}
					</select>
				</div>
				<div>
					<label for="message" class="block text-sm font-medium text-slate-700"
						>Nachricht</label
					>
					<textarea
						name="message"
						id="message"
						rows="5"
						required
						class="mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
					></textarea>
				</div>
				<button
					type="submit"
					class="rounded-md bg-brand px-6 py-3 text-sm font-semibold text-white hover:bg-brand-dark"
				>
					Anfrage senden
				</button>
			</form>
		</div>
	</section>
</Layout>

<script>
	document.querySelectorAll<HTMLButtonElement>('.device-tile').forEach((tile) => {
		tile.addEventListener('click', () => {
			const select = document.getElementById('device');
			if (select instanceof HTMLSelectElement) {
				select.value = tile.dataset.device ?? '';
			}
			document.getElementById('anfrage-formular')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	});
</script>

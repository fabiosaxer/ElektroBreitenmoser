---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import showroomWeinkuehler from '../assets/images/showroom-weinkuehler.jpg';
import showroomGeschichteVzug from '../assets/images/showroom-geschichte-vzug.jpg';
import kuehlschrankfabrikInnen from '../assets/images/kuehlschrankfabrik-innen.jpg';

const milestones = [
	{
		year: '1933',
		title: 'Gründung in Rebstein',
		text: 'Willi Breitenmoser sen. gründet die Einzelfirma – Schwerpunkt Elektroinstallationen.',
		tone: 'brand',
	},
	{
		year: '1959',
		title: 'Willi Breitenmoser jun. übernimmt',
		text: 'Nach seiner Meisterprüfung führt er den Betrieb nach dem Tod des Vaters weiter.',
		tone: 'brand',
	},
	{
		year: '1975',
		title: 'Umwandlung in die Elektro Breitenmoser AG',
		text: 'Elektroinstallationen, Telefonie, Freileitungsunterhalt und Kabelbau unter einem Dach.',
		tone: 'brand',
	},
	{
		year: '1997',
		title: 'Daniel Benz übernimmt die Firma',
		text: 'Der Verkauf von V-ZUG Geräten wird konsequent ausgebaut.',
		tone: 'vzug',
	},
	{
		year: '2013',
		title: 'Neubau an der Fortunastrasse',
		text: 'Erster Plus-Energie-Gewerbebau der Schweiz in Marbach – ausgezeichnet von der Solar Agentur Schweiz für den Minergie-P-Neubau.',
		tone: 'brand',
	},
	{
		year: 'Heute',
		title: 'Elektro Breitenmoser AG',
		text: 'Führender Fachhandel für V-ZUG Einbau-Haushaltgeräte im Rheintal, unter der Leitung von Daniel Benz – mit Photovoltaik-Anlagen als weiterem Standbein.',
		tone: 'brand',
	},
];

const h2 =
	'text-[24px] leading-[1.3] font-semibold text-slate-900 sm:text-[28px] md:text-[30px] lg:text-[34px]';
---

<Layout title="Über uns – V-ZUG Regionalpartner" description="Die Geschichte der Elektro Breitenmoser AG – traditionsreicher V-ZUG Regionalpartner in Marbach im Rheintal.">
	<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
		<p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-vzug">
			Traditionsreicher V-ZUG Regionalpartner im Rheintal
		</p>
		<h1 class="mt-3 text-[32px] font-bold leading-[1.15] text-slate-900 sm:text-[40px] sm:leading-[1.1] lg:text-[56px]">
			Über uns
		</h1>
		<p class="mx-auto mt-4 max-w-2xl text-slate-600">
			Persönliche Beratung, ausgeprägte Produktkenntnis und Schweizer Qualität –
			das ist unser Anspruch als V-ZUG Regionalpartner im Rheintal.
		</p>
	</section>

	<section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
		<ol class="relative">
			<div
				class="absolute inset-y-0 left-4 w-0.5 bg-gradient-to-b from-brand via-brand to-accent md:left-1/2 md:-translate-x-1/2"
			>
			</div>
			{
				milestones.map((m, i) => (
					<li class="relative mb-10 pl-12 last:mb-0 md:mb-16 md:grid md:grid-cols-2 md:gap-10 md:pl-0">
						<span
							class="absolute left-4 top-1.5 h-4 w-4 -translate-x-1/2 rounded-full border-4 border-white bg-accent shadow-[0_0_0_3px_var(--color-brand)] md:left-1/2"
						/>
						<div
							class:list={[
								'rounded-xl border border-slate-200 bg-white p-6 shadow-sm',
								i % 2 === 0
									? 'md:col-start-1 md:text-right'
									: 'md:col-start-2 md:row-start-1',
							]}
						>
							<span
								class:list={[
									'text-2xl font-bold',
									m.tone === 'vzug' ? 'text-vzug' : 'text-brand-dark',
								]}
							>
								{m.year}
							</span>
							<h2 class="mt-1 text-lg font-semibold text-slate-900">{m.title}</h2>
							<p class="mt-2 text-slate-600">{m.text}</p>
						</div>
					</li>
				))
			}
		</ol>
	</section>

	<section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6">
		<div class="grid items-center gap-10 rounded-xl border border-slate-200 bg-brand-50 p-6 sm:p-8 md:grid-cols-2">
			<div class="grid grid-cols-2 gap-3 overflow-hidden rounded-lg border-t-4 border-t-vzug">
				<Image
					src={showroomGeschichteVzug}
					alt="Historische V-ZUG Waschmaschinen im Museum"
					class="col-span-2 object-cover"
					widths={[400, 800, 1200]}
					sizes="(min-width: 768px) 25vw, 50vw"
				/>
				<Image
					src={kuehlschrankfabrikInnen}
					alt="Produktion im V-ZUG Werk Sulgen"
					class="col-span-2 aspect-[3/1] object-cover"
					widths={[400, 800, 1200]}
					sizes="(min-width: 768px) 25vw, 50vw"
				/>
			</div>
			<div>
				<h2 class={h2}>V-ZUG seit 1913</h2>
				<p class="mt-3 text-slate-600">
					Von der ersten vollautomatischen Waschmaschine bis zur CO2-neutralen
					Produktion im Werk Sulgen: Als Regionalpartner tragen wir dieselbe
					Schweizer Tradition aus Präzision und Qualität mit, die V-ZUG seit über
					100 Jahren auszeichnet.
				</p>
			</div>
		</div>
	</section>

	<section class="bg-slate-50 py-16">
		<div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 md:grid-cols-2">
			<Image
				src={showroomWeinkuehler}
				alt="V-ZUG Weinkühlschrank im Showroom"
				class="rounded-lg object-cover shadow-sm"
				widths={[400, 800, 1200]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
			<div>
				<h2 class={h2}>Bereit für Ihr Projekt?</h2>
				<p class="mt-3 text-slate-600">
					Ob neue Küche oder Waschraum – wir beraten Sie unverbindlich und
					begleiten Sie von der Auswahl bis zum fertig eingebauten Gerät.
				</p>
				<a
					href="/geraeteanfrage/"
					class="mt-6 inline-block rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white hover:bg-brand-dark"
				>
					Geräteanfrage stellen
				</a>
			</div>
		</div>
	</section>
</Layout>

---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ApplianceIcon from '../components/ApplianceIcon.astro';
import { rooms } from '../data/appliances';
import heroStandort from '../assets/images/hero-standort.jpg';
import installation from '../assets/images/ueber-uns-installation.jpg';
import showroomKueche from '../assets/images/showroom-kueche.jpg';
import showroomKuechengeraete from '../assets/images/showroom-kuechengeraete.jpg';
import showroomWeinkuehler from '../assets/images/showroom-weinkuehler.jpg';
import showroomWaeschetuerme from '../assets/images/showroom-waeschetuerme.jpg';
import kuehlschrankfabrikBanner from '../assets/images/kuehlschrankfabrik-banner.jpg';
import rezepteInspiration from '../assets/images/rezepte-inspiration.jpg';
import rezepteFingerfood from '../assets/images/rezepte-fingerfood.jpg';
import lieferwagen from '../assets/images/lieferwagen.jpg';
import esafMunikuh1 from '../assets/images/esaf-munikuh-1.jpg';
import esafMunikuh2 from '../assets/images/esaf-munikuh-2.jpg';

const showroom = [
	{
		src: showroomKueche,
		alt: 'V‑ZUG Kücheninsel mit Kühlschrank und Backöfen im Showroom',
		caption: 'Kücheninsel mit V‑ZUG Kühl- und Backgeräten',
	},
	{
		src: showroomKuechengeraete,
		alt: 'V‑ZUG Einbaugeräte in offener Küche',
		caption: 'V‑ZUG Einbaugeräte in offener Küche',
	},
	{
		src: showroomWeinkuehler,
		alt: 'V‑ZUG Weinkühlschrank, eingebaut',
		caption: 'V‑ZUG Weinkühlschrank',
	},
	{
		src: showroomWaeschetuerme,
		alt: 'V‑ZUG Waschtürme im Showroom',
		caption: 'V‑ZUG Waschtürme',
	},
];

const h2 =
	'text-[24px] leading-[1.3] font-semibold text-slate-900 sm:text-[28px] md:text-[30px] lg:text-[34px]';
const h3 = 'text-[18px] leading-[1.3] font-semibold text-slate-900';
const kickerBrand = 'text-[13px] font-semibold uppercase tracking-[0.08em] text-brand-dark';
---

<Layout title="V‑ZUG Fachhändler Marbach" description="Elektro Breitenmoser AG in Marbach: traditionsreicher V‑ZUG Fachhändler mit persönlicher Beratung, Verkauf, Lieferung und Installation.">
	<section class="relative">
		<Image
			src={heroStandort}
			alt="Standort und V‑ZUG Showroom der Elektro Breitenmoser AG in Marbach"
			class="h-[320px] w-full object-cover sm:h-[520px]"
			widths={[640, 1024, 1600]}
			sizes="100vw"
			quality={75}
			loading="eager"
			fetchpriority="high"
		/>
		<div class="absolute inset-0 hidden bg-gradient-to-t from-black/80 via-black/40 to-transparent sm:block"></div>
		<div class="relative bg-brand-dark px-4 py-8 text-center text-white sm:absolute sm:inset-0 sm:flex sm:items-end sm:bg-transparent sm:px-0 sm:py-0">
			<div class="mx-auto w-full max-w-6xl sm:px-6 sm:pb-12">
				<h1
					class="text-[28px] font-bold leading-[1.15] sm:text-[40px] sm:leading-[1.1] sm:[text-shadow:0_2px_10px_rgb(0_0_0_/_55%)] lg:text-[56px]"
				>
					Ihr V‑ZUG Fachhändler in Marbach
				</h1>
				<p class="mx-auto mt-3 max-w-2xl text-base text-white/95 sm:mt-4 sm:text-lg sm:[text-shadow:0_1px_6px_rgb(0_0_0_/_60%)]">
					Seit fast 100 Jahren beraten wir Sie persönlich rund um V‑ZUG Geräte für
					Küche und Waschraum – von der Auswahl bis zur Installation.
				</p>
				<div class="mt-6 flex flex-wrap justify-center gap-4 sm:mt-8">
					<a
						href="/geraeteanfrage/"
						class="rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark"
					>
						Geräteanfrage stellen
					</a>
					<a
						href="tel:0717771276"
						class="rounded-full border border-white/70 px-6 py-3 text-sm font-semibold text-white transition hover:border-white hover:bg-white/10"
					>
						071 777 12 76 anrufen
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-brand-50 py-4">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<ul class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm font-medium text-brand-dark sm:grid-cols-4 sm:gap-0 sm:divide-x sm:divide-brand-100">
				<li class="flex items-center gap-2 sm:justify-center sm:px-4">
					<a href="/ueber-uns/" class="flex items-center gap-2 hover:text-brand-dark">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-5 w-5 flex-shrink-0"
							aria-hidden="true"
						>
							<circle cx="12" cy="12" r="9" />
							<path d="M12 7v5l3 2" />
						</svg>
						<span>Traditionsbetrieb seit bald 100 Jahren</span>
					</a>
				</li>
				<li class="flex items-center gap-2 sm:justify-center sm:px-4">
					<a href="/nachhaltigkeit/" class="flex items-center gap-2 hover:text-brand-dark">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-5 w-5 flex-shrink-0"
							aria-hidden="true"
						>
							<path d="M12 3c-4 3-7 7-7 11a7 7 0 0 0 14 0c0-4-3-8-7-11z" />
							<path d="M12 12v9" />
						</svg>
						<span>Nachhaltigkeit</span>
					</a>
				</li>
				<li class="flex items-center gap-2 sm:justify-center sm:px-4">
					<a href="#beratung-lieferung-installation" class="flex items-center gap-2 hover:text-brand-dark">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-5 w-5 flex-shrink-0"
							aria-hidden="true"
						>
							<rect x="2" y="7" width="12" height="9" rx="1" />
							<path d="M14 10h4l3 3v3h-7z" />
							<circle cx="7" cy="18" r="1.6" />
							<circle cx="17" cy="18" r="1.6" />
						</svg>
						<span>Lieferung in die ganze Deutschschweiz</span>
					</a>
				</li>
				<li class="flex items-center gap-2 sm:justify-center sm:px-4">
					<a href="/downloads/" class="flex items-center gap-2 hover:text-brand-dark">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							class="h-5 w-5 flex-shrink-0"
							aria-hidden="true"
						>
							<path d="M12 3v12" />
							<path d="M7 10l5 5 5-5" />
							<path d="M4 19h16" />
						</svg>
						<span>Pflegetipps zum Download</span>
					</a>
				</li>
			</ul>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
		<p class={kickerBrand}>Wählen Sie Ihren Gerätebereich</p>
		<h2 class:list={['mt-2', h2]}>Wofür interessieren Sie sich?</h2>
		<p class="mt-2 max-w-2xl text-slate-600">
			Wählen Sie Ihren Gerätebereich für mehr Informationen und eine gezielte
			Geräteanfrage.
		</p>
		{
			rooms.map((r) => (
				<div class="mt-8">
					<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
						{r.room}
					</h3>
					<div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
						{r.items.map((item) => (
							<a
								href={`/geraete/${item.slug}/`}
								class="group flex flex-col items-center gap-3 rounded-xl border border-brand-100 bg-white p-5 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-brand hover:bg-brand-50 hover:shadow-md"
							>
								<ApplianceIcon
									name={item.slug}
									class="h-10 w-10 text-brand transition group-hover:text-brand-dark"
								/>
								<span class="text-sm font-medium text-slate-700">{item.label}</span>
							</a>
						))}
					</div>
				</div>
			))
		}
	</section>

	<section class="bg-brand-50 py-16 lg:py-24">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<h2 class={h2}>Einblick in unser Sortiment</h2>
			<p class="mt-2 max-w-2xl text-slate-600">
				Eindrücke aus dem V‑ZUG Showroom – von der Kücheninsel bis zum Waschturm.
			</p>
			<div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
				{
					showroom.map((item) => (
						<div class="relative aspect-square overflow-hidden rounded-lg">
							<Image
								src={item.src}
								alt={item.alt}
								class="h-full w-full object-cover"
								widths={[300, 500, 640]}
								sizes="(min-width: 768px) 25vw, 50vw"
								quality={70}
							/>
							<p class="absolute inset-x-0 bottom-0 bg-slate-900/60 px-2 py-1.5 text-xs font-medium text-white">
								{item.caption}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<section id="beratung-lieferung-installation" class="py-16 lg:py-24">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<h2 class={h2}>Beratung, Lieferung und Installation</h2>
			<div class="mt-10 grid gap-10 md:grid-cols-[1.1fr_1fr_1fr] md:items-start">
				<div class="group relative aspect-[4/3] w-full overflow-hidden rounded-lg shadow-sm">
					<Image
						src={lieferwagen}
						alt="Lieferwagen der Elektro Breitenmoser AG für die Auslieferung von V‑ZUG Geräten"
						class="absolute inset-0 h-full w-full object-cover transition-opacity duration-500 group-hover:opacity-0"
						widths={[400, 800, 1200]}
						sizes="(min-width: 768px) 33vw, 100vw"
					/>
					<Image
						src={installation}
						alt="Von der Elektro Breitenmoser AG installierter V‑ZUG Waschturm"
						class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
						widths={[400, 800, 1200]}
						sizes="(min-width: 768px) 33vw, 100vw"
					/>
				</div>
				<div>
					<h3 class={h3}>Persönlich vor Ort</h3>
					<p class="mt-3 text-slate-600">
						Als Ihr V‑ZUG Fachhändler begleiten wir Sie persönlich – von der
						Beratung im Showroom über die Lieferung bis zur fachgerechten
						Installation bei Ihnen zu Hause.
					</p>
					<a
						href="/ueber-uns/"
						class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand hover:text-brand-dark"
					>
						Mehr über uns erfahren
						<span aria-hidden="true">→</span>
					</a>
				</div>
				<div>
					<h3 class={h3}>Service &amp; Lieferung</h3>
					<ul class="mt-3 space-y-2 text-slate-600">
						<li>Persönliche Beratung und Verkauf von V‑ZUG Geräten</li>
						<li>Lieferung in die ganze Deutschschweiz</li>
					</ul>
					<p class="mt-4 text-sm text-slate-500">
						Hinweis: Ersatzteile verkaufen wir nicht direkt ab Lager. Bei
						Ersatzteilbedarf wenden Sie sich bitte an V‑ZUG direkt: 058 767 67 84.
					</p>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 lg:py-24">
		<div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 md:grid-cols-2">
			<div class="flex flex-col overflow-hidden rounded-xl border border-slate-200 border-t-4 border-t-vzug">
				<Image
					src={kuehlschrankfabrikBanner}
					alt="V‑ZUG Kühlschrankwerk in Sulgen"
					class="h-40 w-full object-cover"
					widths={[400, 800]}
					sizes="(min-width: 768px) 50vw, 100vw"
				/>
				<div class="flex flex-1 flex-col p-6">
					<img
						src="/vzug-partner-badge.png"
						alt="V‑ZUG Partner"
						class="h-12 w-auto self-start"
					/>
					<h2 class:list={['mt-4', h3]}>V‑ZUG Partner</h2>
					<p class="mt-2 text-sm text-slate-600">
						Die Wurzeln von V‑ZUG reichen bis 1913 zurück – seit Generationen
						steht die Marke für Schweizer Qualität. Dazu zählt auch das
						CO2-neutrale Werk Sulgen, laut V‑ZUG die "modernste Kühlgerätefabrik
						Europas". Als V‑ZUG Partner beraten wir Sie mit direktem Zugang zu
						Herstellerwissen und aktueller Produktkompetenz – kein Graumarkt-Handel.
					</p>
				</div>
			</div>
			<div class="flex flex-col overflow-hidden rounded-xl border border-slate-200">
				<div class="group relative h-40 w-full overflow-hidden">
					<Image
						src={rezepteInspiration}
						alt="Inspiration für Rezepte mit V‑ZUG Geräten"
						class="absolute inset-0 h-full w-full object-cover transition-opacity duration-500 group-hover:opacity-0"
						widths={[400, 800]}
						sizes="(min-width: 768px) 50vw, 100vw"
					/>
					<Image
						src={rezepteFingerfood}
						alt="Feine Fingerfood-Kreationen, zubereitet mit V‑ZUG Geräten"
						class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100"
						widths={[400, 800]}
						sizes="(min-width: 768px) 50vw, 100vw"
					/>
				</div>
				<div class="flex flex-1 flex-col p-6">
					<h2 class={h3}>Rezeptideen entdecken</h2>
					<p class="mt-2 text-sm text-slate-600">
						Was lässt sich mit Ihrem V‑ZUG Gerät alles zaubern? Auf vzug.com
						finden Sie zahlreiche Rezepte, abgestimmt auf Ihre Geräte.
					</p>
					<a
						href="https://www.vzug.com/ch/de/recipes"
						target="_blank"
						rel="noopener noreferrer"
						class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent-dark hover:text-accent"
					>
						Rezepte entdecken
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="py-16 lg:py-24">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<p class={kickerBrand}>Aktuelles</p>
			<h2 class:list={['mt-2', h2]}>Zu Besuch am V‑ZUG Partner Day</h2>
			<p class="mt-3 max-w-2xl text-slate-600">
				Als V‑ZUG Partner waren wir am V‑ZUG Partner Day dabei und haben uns aus
				erster Hand über Neuheiten informiert – darunter auch V‑ZUGs Engagement als
				Munipartner am Eidgenössischen Schwing- und Älplerfest (ESAF) 2028 in Thun.
			</p>
			<div class="mt-8 grid grid-cols-2 gap-4">
				<Image
					src={esafMunikuh1}
					alt="Munikuh-Trophäe mit V‑ZUG Logo am V‑ZUG Partner Day, Sponsoring ESAF 2028 Thun"
					class="aspect-[4/3] w-full rounded-lg object-cover shadow-sm"
					widths={[400, 800]}
					sizes="(min-width: 768px) 25vw, 50vw"
				/>
				<Image
					src={esafMunikuh2}
					alt="ESAF 2028 Munikuh-Trophäe, V‑ZUG Munipartner"
					class="aspect-[4/3] w-full rounded-lg object-cover shadow-sm"
					widths={[400, 800]}
					sizes="(min-width: 768px) 25vw, 50vw"
				/>
			</div>
		</div>
	</section>
</Layout>

---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ApplianceIcon from '../components/ApplianceIcon.astro';
import { rooms } from '../data/appliances';
import heroStandort from '../assets/images/hero-standort.jpg';
import installation from '../assets/images/ueber-uns-installation.jpg';
import showroomKueche from '../assets/images/showroom-kueche.jpg';
import showroomKuechengeraete from '../assets/images/showroom-kuechengeraete.jpg';
import showroomWeinkuehler from '../assets/images/showroom-weinkuehler.jpg';
import showroomWaeschetuerme from '../assets/images/showroom-waeschetuerme.jpg';
import servicefahrzeugIdbuzz from '../assets/images/servicefahrzeug-idbuzz.jpg';
import symbolbildLieferung from '../assets/images/symbolbild-lieferung.jpg';
import kuehlschrankfabrikBanner from '../assets/images/kuehlschrankfabrik-banner.jpg';
import rezepteInspiration from '../assets/images/rezepte-inspiration.jpg';

const showroom = [
	{ src: showroomKueche, alt: 'V-ZUG Kücheninsel mit Kühlschrank und Backöfen im Showroom' },
	{ src: showroomKuechengeraete, alt: 'V-ZUG Einbaugeräte in offener Küche' },
	{ src: showroomWeinkuehler, alt: 'V-ZUG Weinkühlschrank, eingebaut' },
	{ src: showroomWaeschetuerme, alt: 'V-ZUG Waschtürme im Showroom' },
];
---

<Layout title="Start" description="Ihr V-ZUG Fachhändler und Servicepartner im Rheintal – persönliche Beratung seit fast 100 Jahren.">
	<section class="relative">
		<Image
			src={heroStandort}
			alt="Filiale der Elektro Breitenmoser AG in Marbach"
			class="h-[420px] w-full object-cover sm:h-[520px]"
			widths={[640, 1024, 1600]}
			sizes="100vw"
		/>
		<div class="absolute inset-0 bg-vzug/70"></div>
		<div class="absolute inset-0 flex items-center">
			<div class="mx-auto w-full max-w-6xl px-4 text-center text-white sm:px-6">
				<h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
					Ihr V-ZUG Partner in Marbach
				</h1>
				<p class="mx-auto mt-4 max-w-2xl text-lg text-white/90">
					Seit fast 100 Jahren beraten wir Sie persönlich rund um V-ZUG Küchen- und
					Waschereigeräte – kompetent, zuverlässig und aus dem Rheintal.
				</p>
				<div class="mt-8 flex flex-wrap justify-center gap-4">
					<a
						href="tel:0717771276"
						class="rounded-md bg-accent px-6 py-3 text-sm font-semibold text-white hover:bg-accent-dark"
					>
						071 777 12 76 anrufen
					</a>
					<a
						href="/geraeteanfrage"
						class="rounded-md border border-white/70 px-6 py-3 text-sm font-semibold text-white hover:border-white hover:bg-white/10"
					>
						Geräteanfrage stellen
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<h2 class="text-2xl font-semibold text-slate-900">Wofür dürfen wir Sie beraten?</h2>
		<p class="mt-2 max-w-2xl text-slate-600">
			Wählen Sie einen Gerätebereich – wir übernehmen Ihre Auswahl direkt in die
			Geräteanfrage.
		</p>
		{
			rooms.map((r) => (
				<div class="mt-8">
					<h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
						{r.room}
					</h3>
					<div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
						{r.items.map((item) => (
							<a
								href={`/geraeteanfrage?geraet=${item.slug}`}
								class="group flex flex-col items-center gap-3 rounded-xl border border-slate-200 bg-white p-5 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-brand hover:shadow-md"
							>
								<ApplianceIcon
									name={item.slug}
									class="h-10 w-10 text-brand transition group-hover:text-accent"
								/>
								<span class="text-sm font-medium text-slate-700">{item.label}</span>
							</a>
						))}
					</div>
				</div>
			))
		}
	</section>

	<section class="bg-slate-50 py-16">
		<div class="mx-auto max-w-6xl px-4 sm:px-6">
			<h2 class="text-2xl font-semibold text-slate-900">Einblick in unser Sortiment</h2>
			<p class="mt-2 max-w-2xl text-slate-600">
				Eindrücke aus dem V-ZUG Showroom – von der Kücheninsel bis zum Waschturm.
			</p>
			<div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
				{
					showroom.map((item) => (
						<Image
							src={item.src}
							alt={item.alt}
							class="aspect-square w-full rounded-lg object-cover"
							widths={[300, 500, 800]}
							sizes="(min-width: 768px) 25vw, 50vw"
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="py-16">
		<div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 md:grid-cols-2">
			<Image
				src={installation}
				alt="Von der Elektro Breitenmoser AG installierter V-ZUG Waschturm"
				class="rounded-lg object-cover shadow-sm"
				widths={[400, 800, 1200]}
				sizes="(min-width: 768px) 50vw, 100vw"
			/>
			<div>
				<h2 class="text-2xl font-semibold text-slate-900">Persönlich vor Ort</h2>
				<p class="mt-3 text-slate-600">
					Als familiär geführter Betrieb im Rheintal begleiten wir Sie von der
					Beratung im Showroom über die Lieferung bis zur fachgerechten
					Installation – persönlich und zuverlässig.
				</p>
				<a
					href="/ueber-uns"
					class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand hover:text-brand-dark"
				>
					Mehr über uns erfahren
					<span aria-hidden="true">→</span>
				</a>
			</div>
		</div>
	</section>

	<section class="bg-slate-50 py-16">
		<div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 md:grid-cols-2">
			<div class="grid grid-cols-2 gap-4 md:order-2">
				<Image
					src={servicefahrzeugIdbuzz}
					alt="Servicefahrzeug der Elektro Breitenmoser AG"
					class="col-span-2 rounded-lg object-cover shadow-sm"
					widths={[400, 800, 1200]}
					sizes="(min-width: 768px) 50vw, 100vw"
				/>
				<Image
					src={symbolbildLieferung}
					alt="Versand von V-ZUG Geräten in die ganze Schweiz"
					class="col-span-2 aspect-[3/1] rounded-lg object-cover shadow-sm"
					widths={[400, 800, 1200]}
					sizes="(min-width: 768px) 50vw, 100vw"
				/>
			</div>
			<div>
				<h2 class="text-2xl font-semibold text-slate-900">Service &amp; Lieferung</h2>
				<ul class="mt-3 space-y-2 text-slate-600">
					<li>Persönliche Beratung und Verkauf von V-ZUG Geräten</li>
					<li>Geräteservice und Support</li>
					<li>Versand in die ganze Schweiz</li>
				</ul>
				<p class="mt-4 text-sm text-slate-500">
					Hinweis: Ersatzteile verkaufen wir nicht direkt ab Lager. Bei
					Ersatzteilbedarf wenden Sie sich bitte an V-ZUG direkt: 058 767 67 84.
				</p>
			</div>
		</div>
	</section>

	<section class="py-16">
		<div class="mx-auto grid max-w-6xl gap-6 px-4 sm:px-6 md:grid-cols-2">
			<div class="flex flex-col overflow-hidden rounded-xl border border-slate-200">
				<Image
					src={kuehlschrankfabrikBanner}
					alt="V-ZUG Kühlschrankwerk in Sulgen"
					class="h-40 w-full object-cover"
					widths={[400, 800]}
					sizes="(min-width: 768px) 50vw, 100vw"
				/>
				<div class="flex flex-1 flex-col p-6">
					<img
						src="/vzug-partner-badge.png"
						alt="V-ZUG Regionalpartner"
						class="h-12 w-auto self-start"
					/>
					<h2 class="mt-4 text-lg font-semibold text-slate-900">V-ZUG Regionalpartner</h2>
					<p class="mt-2 text-sm text-slate-600">
						V-ZUG steht seit 1913 für Schweizer Qualität. Im Werk Sulgen entsteht
						seit 2022 CO2-neutral die modernste Kühlgerätefabrik Europas – als
						Regionalpartner bieten wir Ihnen das gesamte Sortiment vor Ort.
					</p>
				</div>
			</div>
			<div class="flex flex-col overflow-hidden rounded-xl border border-slate-200">
				<Image
					src={rezepteInspiration}
					alt="Inspiration für Rezepte mit V-ZUG Geräten"
					class="h-40 w-full object-cover"
					widths={[400, 800]}
					sizes="(min-width: 768px) 50vw, 100vw"
				/>
				<div class="flex flex-1 flex-col p-6">
					<h2 class="text-lg font-semibold text-slate-900">Rezeptideen entdecken</h2>
					<p class="mt-2 text-sm text-slate-600">
						Was lässt sich mit Ihrem V-ZUG Gerät alles zaubern? Auf vzug.com
						finden Sie zahlreiche Rezepte, abgestimmt auf Ihre Geräte.
					</p>
					<a
						href="https://www.vzug.com/ch/de/recipes"
						target="_blank"
						rel="noopener noreferrer"
						class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-dark"
					>
						Rezepte entdecken
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<h2 class="text-2xl font-semibold text-slate-900">Besuchen Sie uns</h2>
		<p class="mt-3 text-slate-600">
			Fortunastrasse 2, CH-9437 Marbach · Besuche nach Vereinbarung – rufen Sie uns
			vorab kurz an.
		</p>
	</section>
</Layout>

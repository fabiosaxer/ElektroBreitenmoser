---
import Layout from '../../layouts/Layout.astro';
import ApplianceIcon from '../../components/ApplianceIcon.astro';
import { rooms } from '../../data/appliances';

const h2 =
	'text-[24px] leading-[1.3] font-semibold text-slate-900 sm:text-[28px] md:text-[30px]';

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Start', item: new URL('/', Astro.site).toString() },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Gerätekategorien',
			item: new URL('/geraete/', Astro.site).toString(),
		},
	],
};
---

<Layout
	title="V‑ZUG Gerätekategorien Marbach"
	description="Alle V‑ZUG Gerätekategorien: Küche und Waschraum. Beratung bei der Elektro Breitenmoser AG in der Ostschweiz, Lieferung in die ganze Deutschschweiz."
>
	<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
		<nav aria-label="Breadcrumb" class="mb-4 text-xs text-slate-500">
			<a href="/" class="hover:text-brand">Start</a>
			<span aria-hidden="true"> / </span>
			<span class="text-slate-700">Gerätekategorien</span>
		</nav>
		<h1 class="text-3xl font-bold text-slate-900 sm:text-4xl">Gerätekategorien</h1>
		<p class="mt-3 max-w-2xl text-slate-600">
			Von der Kücheninsel bis zum Waschraum – wählen Sie eine Kategorie für mehr Informationen
			und eine unverbindliche Geräteanfrage.
		</p>
		{
			rooms.map((r) => (
				<div class="mt-10">
					<h2 class={h2}>{r.room}</h2>
					<div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
						{r.items.map((item) => (
							<a
								href={`/geraete/${item.slug}/`}
								class="group flex flex-col items-center gap-3 rounded-xl border border-brand-100 bg-white p-5 text-center shadow-sm transition hover:-translate-y-0.5 hover:border-brand hover:bg-brand-50 hover:shadow-md"
							>
								<ApplianceIcon
									name={item.slug}
									class="h-10 w-10 text-brand transition group-hover:text-brand-dark"
								/>
								<span class="text-sm font-medium text-slate-700">{item.label}</span>
							</a>
						))}
					</div>
				</div>
			))
		}
	</section>
	{/* set:html hier nur mit statischen, entwicklerkontrollierten Werten befüllen - kein Nutzer-/CMS-Input ohne Sanitizing */}
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Layout>

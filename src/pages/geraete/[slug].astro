---
import Layout from '../../layouts/Layout.astro';
import ApplianceIcon from '../../components/ApplianceIcon.astro';
import { rooms } from '../../data/appliances';

export function getStaticPaths() {
	return rooms.flatMap((r) =>
		r.items.map((item) => ({
			params: { slug: item.slug },
			props: { item, room: r.room },
		})),
	);
}

const { item, room } = Astro.props;

// Kurzer Fachhändler-/Regionaltext je Raumbereich - deckt zusätzlich zu "Marbach"
// und "Rheintal" auch die Nachbarregionen ab, aus denen laut Marktrecherche
// ebenfalls Kundschaft kommt (St. Gallen, Appenzell), ohne Keyword-Stuffing.
const regionText: Record<string, string> = {
	Küche:
		'Ob Neubauküche, Renovation oder Ersatz eines einzelnen Geräts: Kundinnen und Kunden aus dem ganzen Rheintal, aus St. Gallen und dem Appenzellerland schätzen die persönliche Beratung direkt vor Ort in Marbach.',
	Waschraum:
		'Ob für den neuen Waschraum, die Waschküche im Mehrfamilienhaus oder als Ersatz eines Einzelgeräts: Kundinnen und Kunden aus dem ganzen Rheintal, aus St. Gallen und dem Appenzellerland schätzen die persönliche Beratung direkt vor Ort in Marbach.',
};

// Handverlesene, thematisch sinnvolle Querverlinkung statt automatischer
// "gleicher Raum"-Auswahl (bei 11 Küchengeräte-Kategorien wäre das beliebig).
const relatedSlugs: Record<string, string[]> = {
	'freistehende-gefriergeraete': ['kuehl-gefrierschraenke', 'geschirrspueler'],
	steamer: ['backoefen-herde', 'mikrowellen'],
	'backoefen-herde': ['steamer', 'schubladen'],
	schubladen: ['backoefen-herde', 'kochfelder'],
	mikrowellen: ['backoefen-herde', 'kaffeevollautomaten'],
	kaffeevollautomaten: ['mikrowellen', 'schubladen'],
	kochfelder: ['kochfelder-dunstabzug', 'dunstabzuege'],
	'kochfelder-dunstabzug': ['kochfelder', 'dunstabzuege'],
	dunstabzuege: ['kochfelder', 'kochfelder-dunstabzug'],
	geschirrspueler: ['kuehl-gefrierschraenke', 'freistehende-gefriergeraete'],
	'kuehl-gefrierschraenke': ['freistehende-gefriergeraete', 'geschirrspueler'],
	waschmaschinen: ['waeschetrockner', 'waschtuerme'],
	waeschetrockner: ['waschmaschinen', 'waschtuerme'],
	waschtuerme: ['waschmaschinen', 'waeschetrockner'],
};
const allItems = rooms.flatMap((r) => r.items);
const related = (relatedSlugs[item.slug] ?? [])
	.map((slug) => allItems.find((i) => i.slug === slug))
	.filter((i): i is (typeof allItems)[number] => Boolean(i));

// Titel/Description automatisch kürzen, wenn der Gerätename allein schon lang
// ist (z. B. "Einbau-Kühl- und Gefrierschränke") - hält Title-Tags im ca.
// 50-65-Zeichen-Korridor statt starr immer "... Marbach" anzuhängen.
const titleWithRegion = `V‑ZUG ${item.label} Marbach`;
const seoTitle = `${titleWithRegion} · Elektro Breitenmoser AG`.length <= 60
	? titleWithRegion
	: `V‑ZUG ${item.label}`;
const seoDescription = `V‑ZUG ${item.label} beim Fachhändler in Marbach: persönliche Beratung, Lieferung in die ganze Deutschschweiz und fachgerechte Installation.`;

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Start', item: new URL('/', Astro.site).toString() },
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Gerätekategorien',
			item: new URL('/geraete/', Astro.site).toString(),
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: item.label,
			item: new URL(`/geraete/${item.slug}/`, Astro.site).toString(),
		},
	],
};
---

<Layout title={seoTitle} description={seoDescription}>
	<section class="mx-auto max-w-2xl px-4 py-16 text-center sm:px-6">
		<nav aria-label="Breadcrumb" class="mb-4 text-left text-xs text-slate-500">
			<a href="/" class="hover:text-brand">Start</a>
			<span aria-hidden="true"> / </span>
			<a href="/geraete/" class="hover:text-brand">Gerätekategorien</a>
			<span aria-hidden="true"> / </span>
			<span class="text-slate-700">{item.label}</span>
		</nav>
		<ApplianceIcon name={item.slug} class="mx-auto h-14 w-14 text-brand" />
		<p class="mt-4 text-[13px] font-semibold uppercase tracking-[0.08em] text-brand-dark">
			{room}
		</p>
		<h1 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">V‑ZUG {item.label}</h1>
		<p class="mt-6 text-left text-slate-600">{item.description}</p>
		<p class="mt-4 text-left text-slate-600">
			Als V‑ZUG Partner beraten wir Sie persönlich bei der Auswahl des passenden
			Modells und liefern V‑ZUG Geräte in die ganze Deutschschweiz. Von der Beratung bis zur
			fachgerechten Installation begleiten wir Sie durch den ganzen Prozess.
		</p>
		<p class="mt-4 text-left text-slate-600">
			{regionText[room]}
		</p>
		<a
			href={`/geraeteanfrage/?geraet=${item.slug}`}
			class="mt-8 inline-block rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white hover:bg-brand-dark"
		>
			Anfrage für {item.label} stellen
		</a>
		{
			related.length > 0 && (
				<div class="mt-12 border-t border-slate-200 pt-8 text-left">
					<h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500">
						Das könnte Sie auch interessieren
					</h2>
					<ul class="mt-3 space-y-2">
						{related.map((r) => (
							<li>
								<a
									href={`/geraete/${r.slug}/`}
									class="text-sm font-semibold text-brand hover:text-brand-dark"
								>
									V‑ZUG {r.label} →
								</a>
							</li>
						))}
					</ul>
				</div>
			)
		}
		<p class="mt-6">
			<a href="/geraete/" class="text-sm font-semibold text-brand hover:text-brand-dark"
				>← Alle Gerätekategorien</a
			>
		</p>
	</section>
	{/* set:html hier nur mit statischen, entwicklerkontrollierten Werten befüllen - kein Nutzer-/CMS-Input ohne Sanitizing */}
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
</Layout>

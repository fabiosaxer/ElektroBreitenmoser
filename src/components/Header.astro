---
const navItems = [
	{ href: '/', label: 'Start' },
	{ href: '/ueber-uns', label: 'Über uns' },
	{ href: '/geraeteanfrage', label: 'Geräteanfrage' },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="border-b border-slate-200">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
		<a href="/" class="flex items-center">
			<img src="/logo.png" alt="Elektro Breitenmoser AG" class="h-8 w-auto sm:h-10" />
		</a>
		<nav class="flex items-center gap-6">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class:list={[
							'text-sm font-medium transition-colors hover:text-brand',
							currentPath === item.href ? 'text-brand' : 'text-slate-600',
						]}
					>
						{item.label}
					</a>
				))
			}
			<a
				href="tel:0717771276"
				class="hidden rounded-md bg-brand px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-dark sm:inline-block"
			>
				071 777 12 76
			</a>
		</nav>
	</div>
</header>

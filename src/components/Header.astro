---
const navItems = [
	{ href: '/', label: 'Start' },
	{ href: '/inspiration', label: 'Inspiration' },
	{ href: '/geraeteanfrage', label: 'Geräteanfrage' },
];

const currentPath = new URL(Astro.request.url).pathname;
---

<header class="border-b border-slate-200">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4 sm:px-6">
		<a href="/" class="text-lg font-semibold tracking-tight text-slate-900">
			Elektro Breitenmoser AG
		</a>
		<nav class="flex items-center gap-6">
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class:list={[
							'text-sm font-medium transition-colors hover:text-blue-700',
							currentPath === item.href ? 'text-blue-700' : 'text-slate-600',
						]}
					>
						{item.label}
					</a>
				))
			}
			<a
				href="tel:0717771276"
				class="hidden rounded-md bg-blue-700 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-blue-800 sm:inline-block"
			>
				071 777 12 76
			</a>
		</nav>
	</div>
</header>

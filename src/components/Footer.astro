	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-3">
		<div>
			<h2 class="text-sm font-semibold text-slate-900">Elektro Breitenmoser AG</h2>
			<p class="mt-2 text-sm text-slate-600">
				Fortunastrasse 2<br />
				CH-9437 Marbach
			</p>
		</div>
		<div>
			<h2 class="text-sm font-semibold text-slate-900">Kontakt</h2>
			<p class="mt-2 text-sm text-slate-600">
				Telefon: <a class="hover:text-brand" href="tel:0717771276">071 777 12 76</a><br />
				E-Mail: <a class="hover:text-brand" href="mailto:info@elektrobreitenmoser.ch">info@elektrobreitenmoser.ch</a><br />
				Instagram: <a
					class="hover:text-brand"
					href="https://www.instagram.com/breitenmoserag_vzug/"

---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 md:grid-cols-4">
		<div>
			<h3 class="text-sm font-semibold text-slate-900">Elektro Breitenmoser AG</h3>
			<p class="mt-2 text-sm text-slate-600">
				Fortunastrasse 2<br />
				CH-9437 Marbach
			</p>
		</div>
		<div>
			<h3 class="text-sm font-semibold text-slate-900">Kontakt</h3>
			<p class="mt-2 text-sm text-slate-600">
				Telefon: <a class="hover:text-brand" href="tel:0717771276">071 777 12 76</a><br />
				WhatsApp: <a
					class="hover:text-brand"
					href="https://wa.me/41764252050"
					target="_blank"
					rel="noopener noreferrer">+41 76 425 20 50</a
				><br />
				E-Mail: <a class="hover:text-brand" href="mailto:info@vzugshop.ch">info@vzugshop.ch</a><br />
				Instagram: <a
					class="hover:text-brand"
					href="https://www.instagram.com/breitenmoserag_vzug/"
					target="_blank"
					rel="noopener noreferrer">@breitenmoserag_vzug</a
				>
			</p>
		</div>
		<div>
			<h3 class="text-sm font-semibold text-slate-900">Rechtliches</h3>
			<p class="mt-2 flex flex-col gap-1 text-sm text-slate-600">
				<a class="hover:text-brand" href="/impressum">Impressum</a>
				<a class="hover:text-brand" href="/datenschutz">Datenschutz</a>
			</p>
		</div>
		<div>
			<h3 class="text-sm font-semibold text-slate-900">Besuch &amp; Anfahrt</h3>
			<p class="mt-2 text-sm text-slate-600">
				Besuch nach Vereinbarung – bitte vorab kurz anrufen.
			</p>
			<a
				class="mt-2 inline-flex items-center gap-1.5 text-sm text-slate-600 hover:text-brand"
				href="https://www.google.com/maps/search/?api=1&query=Fortunastrasse+2%2C+CH-9437+Marbach"
				target="_blank"
				rel="noopener noreferrer"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="h-4 w-4 flex-shrink-0"
					aria-hidden="true"
				>
					<path d="M12 21s-7-6.5-7-11.5A7 7 0 0 1 19 9.5C19 14.5 12 21 12 21z" />
					<circle cx="12" cy="9.5" r="2.5" />
				</svg>
				Fortunastrasse 2, CH-9437 Marbach
			</a>
		</div>
	</div>
	<div class="border-t border-slate-200 py-4 text-center text-xs text-slate-500">
		© {year} Elektro Breitenmoser AG
	</div>
</footer>
